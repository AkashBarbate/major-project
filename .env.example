# ==============================================================================
# NewsLens 3.0 — Environment Configuration Template
# Copy this file to '.env' in the project root:
#   copy .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Google Gemini API Key (Recommended / For Topic Discovery Assistant)
# ------------------------------------------------------------------------------
# Used by: LangChain `ChatGoogleGenerativeAI` in src/taxonomy/llm_suggester.py
# Purpose: Generates canonical names, definitions, and aliases for OOD news items in Tab 3 ("✨ Ask LLM").
# Get your free key at: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY="your_google_api_key_here"

# ------------------------------------------------------------------------------
# 2. Tavily Web Search API Key (Optional / Real-Time News Retrieval)
# ------------------------------------------------------------------------------
# Used by: src/web_retrieval/tavily_provider.py
# Purpose: High-speed, fact-checking-optimized web search.
# Fallback: If not provided, NewsLens 3.0 automatically falls back to DuckDuckGo search (zero config, free).
# Get your free tier key (1,000 requests/month) at: https://app.tavily.com/
# TAVILY_API_KEY="tvly-xxxxxxxxxxxxxxxxxxxxxxxx"

# ------------------------------------------------------------------------------
# 3. Hugging Face Hub Token (Optional)
# ------------------------------------------------------------------------------
# Used by: HuggingFace transformers / sentence-transformers
# Purpose: Increases download rate limits when caching models from HF hub.
# (Note: All models for NewsLens 3.0 are already locally cached in models/ and ~/.cache).
# HUGGINGFACEHUB_API_TOKEN="hf_xxxxxxxxxxxxxxxxxxxxxxxx"

# ------------------------------------------------------------------------------
# 4. Database Path (Optional / Default: data/newslens.db)
# ------------------------------------------------------------------------------
# NEWSLENS_DB_PATH="data/newslens.db"

